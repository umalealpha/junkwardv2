# Copy to brain/.env only if you need to override defaults. All optional.
# The defaults below are the SAFE state and require no .env at all.

# Master switch. false = the daily sweep does not touch live data.
BRAIN_ENABLED=false

# Live arms. false = the brain only decides + queues; it sends nothing, moves
# no money, writes to no other system. Leave OFF until the adapters are wired.
BRAIN_LIVE_ARMS=false

BRAIN_PORT=8090

# Shared secret required by POST /approve. UNSET = the approve endpoint is
# DISABLED (403). Set a long random value and share it only with the staff
# allowed to approve queued actions; every approval also records the
# approver's name in the audit log.
BRAIN_APPROVE_TOKEN=

# Real prod hosts (confirmed 2026-07-10):
#   frontend  graphite-v2-prod-fe.alphadirect.co.bw
#   backend/API graphite-v2-prod-be.alphadirect.co.bw   (claims-tracker API lives here)
#   read-only DB graphitebw-rds-ro.alphadirect.co.bw
#   NOTE: graphite.alphadirect.co.bw is the LEGACY host — do NOT use it.
#
# Read-only Graphite access, added by Pramod when live data is wired.
# MUST be a MySQL user with GRANT SELECT ONLY — never write/alter/drop.
# Example (do NOT commit real credentials):
# GRAPHITE_RO_DSN=mysql://brain_readonly:CHANGE_ME@graphitebw-rds-ro.alphadirect.co.bw:3306/graphite
GRAPHITE_RO_DSN=

# Claims-tracker link (create / policy-cover). Shared secret set on the Graphite
# server as API_KEY_CLAIMS_TRACKER; our side must use the SAME value. Sent in the
# 'api-key' header to https://graphite-v2-prod-be.alphadirect.co.bw/api/claims-tracker/*
GRAPHITE_API_BASE=https://graphite-v2-prod-be.alphadirect.co.bw
API_KEY_CLAIMS_TRACKER=

# ── Weekly team extracts (CFO 2026-07-28) ────────────────────────────────────
# Every Monday at midnight (Africa/Gaborone) each team gets its own Excel
# workbook. NOTHING is emailed until BOTH of the following are true:
#   1. BRAIN_INTERNAL_REPORTS=true
#   2. that team has at least one recipient below
# With no recipients set, the workbooks are still built and downloadable from
# the console ("Get the data") — the schedule simply has nobody to send to.
#
# This is a SEPARATE, NARROWER switch than BRAIN_LIVE_ARMS. Live arms govern
# actions that touch a CUSTOMER or move MONEY. Emailing our own Debtors team its
# own worklist is neither, and should not require turning customer arms on.
# Sends are refused unless EVERY recipient is on an approved internal domain.
BRAIN_INTERNAL_REPORTS=false

# CFO 5-day cancellation-notice oversight email (CFO 2026-08-31). Internal-only,
# gated by BRAIN_INTERNAL_REPORTS + the internal-domain check. Empty → the notice
# builds the list but no-ops. Comma-separated internal addresses only.
BRAIN_CANCEL_NOTICE_RECIPIENTS=

# Graphite→Omni analytics PUSH arm (CFO 2026-08-31). SEPARATE, NARROWER switch,
# DECOUPLED from BRAIN_LIVE_ARMS: the push is a PII-free, counts-only, read-only
# OUTBOUND feed to our own Omni, so it can go live while cancellations/SMS stay
# off. Dead unless BOTH this is 'true' AND OMNI_GRAPHITE_INGEST_URL/KEY are set.
BRAIN_OMNI_PUSH_ARMED=false

# Comma-separated. Internal addresses only (see BRAIN_INTERNAL_EMAIL_DOMAINS).
BRAIN_EXTRACT_KYC_RECIPIENTS=
BRAIN_EXTRACT_DEBTORS_RECIPIENTS=
BRAIN_EXTRACT_FINANCE_RECIPIENTS=
BRAIN_EXTRACT_ACCOUNTS_RECIPIENTS=
BRAIN_EXTRACT_ANALYTICS_RECIPIENTS=
# Copied on every team's workbook (optional).
BRAIN_EXTRACT_CFO_RECIPIENTS=

# Domains an extract may be emailed to. Anything else is refused, so a typo
# cannot post the company's debtors book to a personal mailbox.
BRAIN_INTERNAL_EMAIL_DOMAINS=alphadirect.co.bw

# Schedule. Default Sunday 22:00 UTC = Monday 00:00 Africa/Gaborone (UTC+2).
# BRAIN_EXTRACT_UTC_DAY: 0=Sunday … 6=Saturday.
BRAIN_EXTRACT_UTC_DAY=0
BRAIN_EXTRACT_UTC_HOUR=22

# Row cap per sheet. Stated inside every workbook's "Read me" sheet — a cap is
# never applied silently.
BRAIN_EXTRACT_MAX_ROWS=50000
