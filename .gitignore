# Generated dev portal spec — regenerated on container boot from current routes
backend/dev/openapi.json

# Temporary OCR upload chunks (per-session dirs, cleaned up after assembly)
backend/storage/app/scan_chunks/

# ─── User-authored documentation — local only, not in repo ──────
# These are operational notes / handoffs / audits / setup guides
# that should stay on the developer's machine. Code stays in repo
# as normal. Vendor lib README/LICENSE files (e.g. under
# backend/public/Printing/assets/vendors/) are left alone — they're
# part of the vendored library and shouldn't be removed.
/*.md
/PARITY_AUDITS/
/backend/dev/

# Exception: if a service genuinely needs its README in repo (e.g.
# pdf-service has setup instructions other devs need), add a
# negation here:
!pdf-service/README.md

# ─── Backup files & untracked env (pentest repo hygiene) ────────
*.save
*.bak
*.orig
*_backup/
frontend/.env
frontend/.env.local

# Excel and Word lock files. They appear whenever a workbook in docs/ is
# open and are never worth committing -- one was sitting in docs/ untracked.
~$*

# PHPUnit result cache (test outcomes/timings for --order-by=defects). Regenerated on every run.
backend/.phpunit.result.cache
