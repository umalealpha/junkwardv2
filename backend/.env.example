APP_NAME="Alpha Direct Insurance"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:8000
REACT_SPA_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=your-db-host
DB_HOST_WRITE=your-db-write-host
DB_PORT=3306
DB_DATABASE=your-database
DB_USERNAME=your-db-username

DB_HOST_READONLY=your-db-readonly-host
DB_HOST_RO=your-db-readonly-host
DB_DATABASE_READONLY=your-database
DB_USERNAME_READONLY=your-db-readonly-username

DB_SQLITE_DATABASE=C:\code\graphiteBWV8\database\sanctum.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

AWS_URL=your-bucket.s3.your-region.amazonaws.com
AWS_CLOUDFRONT=https://your-distribution.cloudfront.net

# AI Assistant

AI_PROVIDER=groq
AI_ENABLED=1
AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Swiftly Finance integration (V2-only). Secrets issued by Swiftly at
# onboarding — set via SSM SecureString in prod, never commit real values.
SWIFTLY_ENABLED=false
SWIFTLY_BASE_URL=https://api.staging.swiftly.finance
SWIFTLY_API_KEY=
SWIFTLY_PROGRAM_ID=
SWIFTLY_SUPPLIER_ID=
SWIFTLY_WEBHOOK_SECRET=
SWIFTLY_CURRENCY=BWP
SWIFTLY_TIMEOUT=30
SWIFTLY_CONNECT_TIMEOUT=10

# Alpha Transit Cover (courier goods-in-transit) — inbound event webhook from
# transit.alphadirect.co.bw. The token must equal the GRAPHITE_API_KEY set on
# the ATC stack — set via SSM SecureString in prod, never commit real values.
# ALPHA_TRANSIT_ENABLED is only the fallback; the Admin > Integrations toggle
# (integration_settings row 'alpha_transit') is authoritative once set.
ALPHA_TRANSIT_ENABLED=false
ALPHA_TRANSIT_WEBHOOK_TOKEN=

# MAPFRE / MAWDY "maip-travel" v1.0 travel-insurance integration (V2-only).
# Two-stage auth: AWS Cognito client-credentials -> eMiA user token. Secrets
# issued by MAPFRE at onboarding — set via SSM SecureString in prod, never
# commit real values.
MAPFRE_ENABLED=false
MAPFRE_BASE_URL=
MAPFRE_AUTH_URL=
MAPFRE_COGNITO_TOKEN_URL=
MAPFRE_COGNITO_CLIENT_ID=
MAPFRE_COGNITO_CLIENT_SECRET=
MAPFRE_USERNAME=
MAPFRE_PASSWORD=
MAPFRE_COUNTRY=BW
# The `countryId` REQUEST HEADER on /api/v1/* — a DIFFERENT thing from
# MAPFRE_COUNTRY above (the eMiA LOGIN country). Defaults to MAPFRE_COUNTRY.
# The PRE dealer's products are Italian and only countryId=IT is provisioned:
# /quotes and /contract answer 403 "country identifier code not valid" for BW.
# Set IT against PRE; becomes BW once MAPFRE provision a Botswana dealer.
MAPFRE_COUNTRY_ID=
MAPFRE_LANGUAGE=en
MAPFRE_TIMEOUT=30
MAPFRE_CONNECT_TIMEOUT=10

# Alpha Bridge helpdesk — "Report an Issue" widget token proxy. The secret
# is issued by Bridge ops (WIDGET_KEYS entry for the app id below) — set via
# SSM SecureString in prod, never commit the real value. App id is
# per-environment: "graphite-staging" on staging, "graphite" on prod —
# each pairs with its own secret on the Bridge side.
ALPHA_BRIDGE_BASE_URL=https://bridge.alphadirect.co.bw
ALPHA_BRIDGE_WIDGET_APP_ID=graphite
ALPHA_BRIDGE_WIDGET_SECRET=

# MotoLink (motolink.app) INBOUND assessment bridge (claims:motolink-sync).
# OFF / DARK by default — with MOTOLINK_API_KEY blank the scheduled command is a
# complete no-op (no outbound call, no DB write). Set BOTH base + key to enable.
# The key is the partner credential motolink.app accepts (sent as the `api-key`
# header) — this is a SEPARATE secret from API_KEY_CLAIMS_TRACKER (which is the
# inbound key MotoLink uses to call Graphite's policy-cover endpoint). Set via
# SSM SecureString in prod; never commit the real value.
MOTOLINK_API_BASE=
MOTOLINK_API_KEY=
MOTOLINK_SYNC_INTERVAL_MINUTES=15
MOTOLINK_PAGE_SIZE=100
MOTOLINK_TIMEOUT=20
MOTOLINK_MOCK=false
