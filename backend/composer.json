{
    "name": "laravel/laravel",
    "type": "project",
    "description": "Laravel framework",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "aws/aws-sdk-php": "^3.174",
        "aws/aws-sdk-php-laravel": "^3.6",
        "barryvdh/laravel-dompdf": "^0.9.0",
        "barryvdh/laravel-snappy": "^1.0",
        "diglactic/laravel-breadcrumbs": "^9.0",
        "doctrine/dbal": "^3.6",
        "endroid/qr-code": "^4.1",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.3",
        "infobip-community/infobip-api-php-sdk": "^1.1",
        "infobip/infobip-api-php-client": "2.0.1",
        "intervention/image": "^2.5",
        "laravel/fortify": "^1.7",
        "laravel/framework": "^8.12",
        "laravel/jetstream": "^2.3",
        "laravel/sanctum": "^2.14",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^3.2",
        "laravelcollective/html": "^6.2",
        "league/csv": "^9.20",
        "league/flysystem-aws-s3-v3": "~1.0",
        "livewire/livewire": "^2.10",
        "maatwebsite/excel": "^3.1",
        "mailgun/mailgun-php": "^3.5",
        "mattlibera/livewire-flash": "^0.5.1",
        "mediconesystems/livewire-datatables": "^0.10.0",
        "mhmiton/laravel-modules-livewire": "^1.3",
        "nwidart/laravel-modules": "^8.2",
        "ohdearapp/ohdear-php-sdk": "^3.4",
        "owen-it/laravel-auditing": "^12.0",
        "phpmailer/phpmailer": "^6.3",
        "pnlinh/laravel-infobip-sms": "^1.0",
        "rap2hpoutre/laravel-log-viewer": "^1.7",
        "rappasoft/laravel-livewire-tables": "^2.11",
        "readybytes/env-checker": "dev-master",
        "shivella/laravel-bitly": "^1.1",
        "smalot/pdfparser": "^2.0",
        "spatie/laravel-activitylog": "^3.17",
        "spatie/laravel-http-logger": "^1.7",
        "spatie/laravel-permission": "^4.0",
        "spatie/laravel-schedule-monitor": "^2.4",
        "symfony/psr-http-message-bridge": "^2.1",
        "webklex/laravel-pdfmerger": "^1.3",
        "yajra/laravel-datatables-oracle": "^9.15",
        "yoeunes/toastr": "^1.2"
    },
    "require-dev": {
        "andrey-helldar/laravel-app": "^1.0",
        "barryvdh/laravel-debugbar": "^3.5",
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/breeze": "^1.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "audit": {
            "block-insecure": false
        },
        "platform-check": false
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-snappy",
                "davejamesmiller/laravel-breadcrumbs"
            ]
        }
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "AlphaDirect\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "Modules/",
            "Diglactic\\Breadcrumbs\\": "vendor/diglactic/laravel-breadcrumbs/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
