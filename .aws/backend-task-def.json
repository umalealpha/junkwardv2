{
  "family": "graphite-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::623467544388:role/graphite-ecs-task-execution",
  "taskRoleArn": "arn:aws:iam::623467544388:role/graphite-ecs-task-execution",
  "containerDefinitions": [
    {
      "name": "graphite-backend",
      "image": "PLACEHOLDER",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {"name": "APP_ENV", "value": "staging"},
        {"name": "APP_DEBUG", "value": "false"},
        {"name": "CACHE_DRIVER", "value": "redis"},
        {"name": "QUEUE_CONNECTION", "value": "redis"},
        {"name": "SESSION_DRIVER", "value": "redis"},
        {"name": "AI_PROVIDER", "value": "groq"},
        {"name": "AI_ENABLED", "value": "1"},
        {"name": "AI_MODEL", "value": "meta-llama/llama-4-scout-17b-16e-instruct"},
        {"name": "ALPHA_BRAIN_URL", "value": "http://internal-alpha-brain-alb-1777555476.af-south-1.elb.amazonaws.com"}
      ],
      "secrets": [
        {"name": "ALPHA_BRAIN_TOKEN", "valueFrom": "arn:aws:ssm:af-south-1:623467544388:parameter/graphite/BRAIN_APPROVE_TOKEN"},
        {"name": "APP_KEY", "valueFrom": "arn:aws:ssm:af-south-1:623467544388:parameter/graphite/APP_KEY"},
        {"name": "DB_HOST", "valueFrom": "arn:aws:ssm:af-south-1:623467544388:parameter/graphite/DB_HOST"},
        {"name": "DB_HOST_WRITE", "valueFrom": "arn:aws:ssm:af-south-1:623467544388:parameter/graphite/DB_HOST"},
        {"name": "DB_HOST_READONLY", "valueFrom": "arn:aws:ssm:af-south-1:623467544388:parameter/graphite/DB_HOST"},
        {"name": "DB_DATABASE", "valueFrom": "arn:aws:ssm:af-south-1:623467544388:parameter/graphite/DB_DATABASE"},
        {"name": "DB_USERNAME", "valueFrom": "arn:aws:ssm:af-south-1:623467544388:parameter/graphite/DB_USERNAME"},
        {"name": "DB_PASSWORD", "valueFrom": "arn:aws:ssm:af-south-1:623467544388:parameter/graphite/DB_PASSWORD"},
        {"name": "REDIS_HOST", "valueFrom": "arn:aws:ssm:af-south-1:623467544388:parameter/graphite/REDIS_HOST"},
        {"name": "GROQ_API_KEY", "valueFrom": "arn:aws:ssm:af-south-1:623467544388:parameter/graphite/GROQ_API_KEY"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/graphite-backend",
          "awslogs-region": "af-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost/api/v1/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}
