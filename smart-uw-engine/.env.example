# smart-uw-engine sidecar config. Copy to .env (git-ignored) for local dev,
# or set these as container env vars in prod. NEVER commit a real key.
GEMINI_API_KEY=            # Google AI Studio key (AIza...). Prod: from the Credentials Vault.
SMARTUW_GEMINI_MODEL=gemini-2.5-flash
# DeepSeek (OpenAI-compatible) — the alternative commercial provider.
DEEPSEEK_API_KEY=          # DeepSeek key (sk-...). Prod: from the Credentials Vault.
SMARTUW_DEEPSEEK_MODEL=deepseek-chat
# Which commercial provider handles NON-PII data: gemini (default) | deepseek.
# PII is ALWAYS local regardless. In prod the Laravel caller overrides this
# per-request from the vault; this env is the default / dev fallback.
SMARTUW_COMMERCIAL_PROVIDER=gemini
OLLAMA_URL=http://localhost:11434
SMARTUW_OLLAMA_MODEL=llama3.1:8b
SMARTUW_MAX_ROWS_PER_SHEET=400
PORT=8099
