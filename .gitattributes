# Force LF line endings on shell scripts so Windows checkouts don't break
# Docker entrypoint execution (`/usr/bin/env sh\r: bad interpreter`).
*.sh             text eol=lf
*.cron           text eol=lf
docker/*         text eol=lf

# PHP / JS / TS / config text files — normalise to LF
*.php            text eol=lf
*.blade.php      text eol=lf
*.js             text eol=lf
*.jsx            text eol=lf
*.ts             text eol=lf
*.tsx            text eol=lf
*.mjs            text eol=lf
*.cjs            text eol=lf
*.vue            text eol=lf
*.css            text eol=lf
*.scss           text eol=lf
*.html           text eol=lf
*.json           text eol=lf
*.toml           text eol=lf
*.yml            text eol=lf
*.yaml           text eol=lf
*.xml            text eol=lf
*.sql            text eol=lf
Dockerfile*      text eol=lf
Makefile         text eol=lf
.env*            text eol=lf

# Binary assets — never normalise
*.png            binary
*.jpg            binary
*.jpeg           binary
*.gif            binary
*.ico            binary
*.svg            binary
*.pdf            binary
*.xlsx           binary
*.xlsb           binary
*.xls            binary
*.docx           binary
*.doc            binary
*.zip            binary
*.gz             binary
*.tar            binary
*.woff           binary
*.woff2          binary
*.ttf            binary
*.otf            binary
*.glb            binary
*.gltf           binary
